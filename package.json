    "@tailwindcss/typography": "0.5.9",
    "@types/node": "^20.5.0",
    "@types/react": "^18.2.20",
    "@types/react-dom": "^18.2.7",
    "autoprefixer": "10.4.15",
    "classnames": "^2.5.1",
    "clsx": "^2.1.0",
    "contentful": "^10.6.21",
    "contentful-import": "^9.0.4",
